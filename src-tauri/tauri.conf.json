{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leve",
  "version": "0.2.0",
  "identifier": "br.com.moralia.leve",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Leve",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Moralia",
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A lightweight Markdown viewer",
    "longDescription": "Opens .md files with a double-click, reloads on save, with contents, find, themes and PDF export.",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "PortugueseBR"
        ]
      }
    },
    "createUpdaterArtifacts": false,
    "copyright": "Copyright (c) 2026 Moralia"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMjY4QjdFODAwOUUxQjQKUldTMDRRbUFmb3NtOGsvZTQzc3VrbTVjQ2xwclF0c1VMUUsrb0hPUm11T3JnUXBlNFgrazZlRlUK",
      "endpoints": [
        "https://github.com/moraliasp/leve/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
